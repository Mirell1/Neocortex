# NEOCORTEX - modelo do arquivo .env
#
# 1) Copie este arquivo para ".env" (sem o ".example") na mesma pasta do app.py e preencha os valores.
# 2) NUNCA envie o .env para o GitHub. Ele já está no .gitignore; confira com:  git check-ignore -v .env
# 3) Este arquivo (.env.example) pode ir para o GitHub: ele só tem os NOMES, nunca os valores.

# ---------------------------------------------------------------- aplicação (obrigatório)
# Chave que assina o cookie de sessão. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ---------------------------------------------------------------- banco PostgreSQL (obrigatório)
# Supabase: painel > Connect > Session pooler. No pooler o usuário tem o código do projeto: postgres.<código>
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
# Se a senha tiver '#' ou '$', coloque entre aspas simples:  DB_PASSWORD='sua#senha'
DB_PASSWORD=
DB_SSLMODE=require
# DB_POOL_MAX=20

# ---------------------------------------------------------------- IA (Gemini)
GEMINI_API_KEY=
# GEMINI_MODEL=

# ---------------------------------------------------------------- produção (site com HTTPS, ex.: Render)
# SESSION_COOKIE_SECURE=1     # o cookie de sessão só trafega por HTTPS
# NEOCORTEX_PROXY=1           # atrás de proxy: lê o IP real de quem acessa (necessário para o limite de tentativas de login)
# LOGIN_MAX_TENTATIVAS=5      # erros de login por conta+IP em 15 minutos
# LOGIN_ATRASO_MINIMO=0.4     # tempo mínimo (segundos) de uma tentativa de login que falha

# ---------------------------------------------------------------- opcionais
# NEOCORTEX_DEMO=0            # 1 = libera temas e acessórios para a gravação (NUNCA junto com SESSION_COOKIE_SECURE=1)
# NEOCORTEX_GAMIFICACAO=1
# NEOCORTEX_CONFLITO_UI=confirmar
# FLASK_DEBUG=0               # nunca use 1 em produção
# APRENDIZADO_ATRASO_S=
# PROMPTS_DIR=
# PROMPT_CONVERSA=

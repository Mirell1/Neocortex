# Copie para .env e preencha. NUNCA versione o .env (veja RELATORIO_SEGURANCA.md, seção 5).

# Chave de sessão do Flask. Gere uma aleatória:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=neocortex
DB_USER=postgres
DB_PASSWORD=

# Gemini
GEMINI_API_KEY=
# Modelo do Gemini (nome conferido na documentação do Google):
GEMINI_MODEL=gemini-3.8-flash

# --- Opcional: economizar tokens (deixe VAZIO para o comportamento padrão do modelo) ---
# Níveis: minimal | low | medium | high
# Chamada que ENTENDE a mensagem (afeta a qualidade; teste antes de mexer):
GEMINI_THINKING_INTERPRETACAO=
# Chamada que só ESCREVE a resposta depois da ação (mais seguro reduzir; sugestão: low):
GEMINI_THINKING_RESPOSTA=
